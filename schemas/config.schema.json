{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:metalheart:mds:config:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "site", "source", "navigation"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "site": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "version"],
      "properties": {
        "id": {"type":"string", "pattern":"^[a-z0-9][a-z0-9-]{0,79}$"},
        "title": {"type":"string", "minLength":1, "maxLength":160},
        "version": {"type":"string", "minLength":1, "maxLength":80},
        "description": {"type":"string", "maxLength":1000},
        "language": {"type":"string", "pattern":"^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"},
        "channel": {"type":"string", "maxLength":80},
        "homeUrl": {"type":"string"}, "repositoryUrl": {"type":"string"},
        "editBaseUrl": {"type":"string"}, "footer": {"type":"string"},
        "origin": {"type":"string"}, "indexable": {"type":"boolean"}
      }
    },
    "branding": {
      "type":"object", "additionalProperties":false, "required":["logo"],
      "properties":{"logo":{"type":"string","minLength":1},"darkLogo":{"type":"string","minLength":1}}
    },
    "labels": {
      "type":"object",
      "propertyNames":{"enum":["documentation","documentationHome","documentMenu","pageContents","referenceLibrary","projectWebsite","search","appearance","skipToContent","sourceRepository","editPage","backToTop","previous","next"]},
      "additionalProperties":{"type":"string","minLength":1,"maxLength":160}
    },
    "paths": {
      "type":"object", "additionalProperties":false,
      "properties": {
        "basePath":{"type":"string"}, "docsPath":{"type":"string"},
        "output":{"type":"string", "minLength":1}, "metadata":{"type":"string", "minLength":1}
      }
    },
    "source": {
      "type":"object", "additionalProperties":false, "required":["type","root"],
      "properties": {
        "type":{"enum":["local","git","snapshot"]}, "root":{"type":"string", "minLength":1},
        "repository":{"type":"string", "minLength":1},
        "revision":{"type":"string", "pattern":"^[a-f0-9]{40}$"},
        "tag":{"type":"string", "pattern":"^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
        "manifest":{"type":"string", "minLength":1}
      }
    },
    "navigation": {
      "type":"array", "minItems":1, "maxItems":200,
      "items": {
        "type":"object", "additionalProperties":false, "required":["title","pages"],
        "properties": {
          "title":{"type":"string", "minLength":1},
          "pages": {"type":"array", "minItems":1, "items":{
            "type":"object", "additionalProperties":false, "required":["source","slug","label"],
            "properties": {
              "source":{"type":"string", "minLength":1},
              "slug":{"type":"string", "pattern":"^(?:[a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)*)?$"},
              "label":{"type":"string", "minLength":1}, "format":{"enum":["markdown","text"]}
            }
          }}
        }
      }
    },
    "appearance": {
      "type":"object", "additionalProperties":false,
      "properties": {
        "themes":{"type":"array", "uniqueItems":true, "items":{"enum":["neutral","contrast","fil","aotx","ficc","prism","cobalt","violet"]}},
        "palette":{"enum":["neutral","contrast","fil","aotx","ficc","prism","cobalt","violet"]},
        "mode":{"enum":["system","light","dark"]}, "finish":{"enum":["metalheart","flat"]},
        "typography":{"enum":["standard","display"]}, "contrast":{"enum":["system","normal","more"]}
      }
    },
    "markdown": {"type":"object", "additionalProperties":false, "properties":{"html":{"type":"boolean"}, "stripRepositoryChrome":{"type":"boolean"}}},
    "siteSources": {"type":"object", "additionalProperties":{"type":"string", "minLength":1}},
    "publicationEdits": {"type":"array", "items":{"type":"object", "additionalProperties":false, "required":["source","from","to"], "properties":{"source":{"type":"string"}, "from":{"type":"string", "minLength":1}, "to":{"type":"string"}}}},
    "linkedSources": {"type":"array", "items":{"type":"object", "additionalProperties":false, "required":["source","path"], "properties":{"source":{"type":"string"}, "path":{"type":"string"}}}},
    "linkAliases": {"type":"object", "additionalProperties":{"type":"string"}}
  }
}
